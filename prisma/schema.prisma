datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// BETTER AUTH CORE MODELS
// ----------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          String?   @default("maker") // platform-level or default role: "admin", "maker", "approver", "auditor"
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]
  twoFactors    TwoFactor[]

  // Business relations
  createdVouchers Voucher[]            @relation("VoucherCreator")
  auditEvents     VoucherAuditEvent[]  @relation("AuditActor")

  @@map("user")
}

model Session {
  id                   String   @id @default(cuid())
  userId               String
  token                String   @unique
  expiresAt            DateTime
  ipAddress            String?
  userAgent            String?
  activeOrganizationId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  issuer                String?   @default("local:credential")
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String?  @unique
  logo        String?
  metadata    String?
  createdAt   DateTime @default(now())

  members     Member[]
  invitations Invitation[]
  vouchers    Voucher[]
  auditEvents VoucherAuditEvent[]

  @@map("organization")
}

model Member {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           String   @default("maker") // "admin", "maker", "approver", "auditor"
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("member")
}

model Invitation {
  id             String   @id @default(cuid())
  organizationId String
  email          String
  role           String?
  status         String
  expiresAt      DateTime
  inviterId      String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@map("invitation")
}

model TwoFactor {
  id          String @id @default(cuid())
  secret      String
  backupCodes String
  userId      String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("twoFactor")
}

// ----------------------------------------------------
// VOUCHER CORE BUSINESS MODELS
// ----------------------------------------------------

enum VoucherStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PAID
  VOIDED
}

enum PaymentType {
  CASH
  CHEQUE
  BANK_TRANSFER
  OTHER
}

model VoucherSequence {
  id           String   @id @default("default")
  currentValue Int      @default(10012) // Tracks sequential PV numbers
  updatedAt    DateTime @updatedAt

  @@map("voucher_sequence")
}

model Voucher {
  id            String        @id @default(cuid())
  tenantId      String?
  voucherNumber String        @unique // e.g. "PV-10013"
  date          DateTime      @db.Date
  status        VoucherStatus @default(DRAFT)
  paymentType   PaymentType   @default(BANK_TRANSFER)

  // Payee Information
  payeeName        String
  payeeAddress     String
  payeePhone       String
  payeeBankName    String
  payeeBankAccount String

  // Payment Details
  description   String   @db.Text
  invoiceNumber String
  amount        Decimal  @db.Decimal(15, 2)
  currency      String   @default("INR")

  // Banking Details
  chequeNumber String?
  bankNumber   String?

  // Authorization details
  preparedBy     String
  approvalToPay  String
  receiverName   String
  signedPrepared Boolean @default(false)
  signedApprover Boolean @default(false)
  signedReceiver Boolean @default(false)

  // Creator & Timestamps
  createdById String?
  createdBy   User?         @relation("VoucherCreator", fields: [createdById], references: [id])
  tenant      Organization? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Associated relational items
  timeline    VoucherTimelineEvent[]
  auditEvents VoucherAuditEvent[]

  @@index([voucherNumber])
  @@index([status])
  @@index([date])
  @@index([tenantId])
  @@index([createdById])
  @@map("voucher")
}

model VoucherTimelineEvent {
  id        String   @id @default(cuid())
  voucherId String
  type      String   // "created", "submitted", "approved", "rejected", "paid", "voided"
  label     String
  actor     String
  note      String?
  timestamp DateTime @default(now())

  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@index([voucherId])
  @@map("voucher_timeline_event")
}

model VoucherAuditEvent {
  id             String        @id @default(cuid())
  tenantId       String?
  voucherId      String?
  actorId        String?
  actorName      String
  action         String        // "voucher:create", "voucher:submit", "voucher:approve", etc.
  entityType     String        @default("voucher")
  entityId       String?
  metadata       Json?
  note           String?
  ipAddress      String?
  userAgent      String?
  timestamp      DateTime      @default(now())

  voucher      Voucher?      @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  actor        User?         @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([voucherId])
  @@index([tenantId])
  @@index([action])
  @@index([timestamp])
  @@map("voucher_audit_event")
}

model ScheduledVoucher {
  id                     String      @id @default(cuid())
  scheduledDate          DateTime    @db.Date
  status                 String      @default("scheduled") // "scheduled", "generated", "cancelled"
  subsidiary             String      @default("chartered-brokers") // "chartered-brokers" | "medibroker"
  paymentType            PaymentType @default(BANK_TRANSFER)

  // Payee info
  payeeName              String
  payeeAddress           String?
  payeePhone             String?
  payeeBankName          String?
  payeeBankAccount       String?

  // Payment info
  description            String      @db.Text
  invoiceNumber          String?
  amount                 Decimal     @db.Decimal(15, 2)
  currency               String      @default("MUR")

  // Banking info
  bankNumber             String?     // Subsidiary credited bank account
  chequeNumber           String?

  // Authorization info
  preparedBy             String
  approvalToPay          String
  receiverName           String?

  // Workflow options
  initialStatus          String      @default("pending-approval")

  // Generation linkage
  generatedVoucherId     String?
  generatedVoucherNumber String?
  generatedAt            DateTime?

  createdById            String?
  createdByName          String?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  @@index([scheduledDate])
  @@index([status])
  @@map("scheduled_voucher")
}

